{
  "name": "@azure/connectors-nodejs-sdk",
  "version": "1.2.0",
  "description": "Universal TypeScript SDK for Azure Logic Apps Connectors (ESM & CommonJS compatible)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/samples/connectorFunctions.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "azure",
    "connectors",
    "logic-apps",
    "office365",
    "sharepoint",
    "teams",
    "typescript",
    "sdk"
  ],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "glob": "^13.0.6",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@azure/core-auth": "^1.7.0",
    "@azure/core-client": "^1.7.0",
    "@azure/core-rest-pipeline": "^1.12.0",
    "@azure/identity": "^4.0.0",
    "@azure/msal-node": "^2.7.0",
    "axios": "^1.6.0",
    "form-data": "^4.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
