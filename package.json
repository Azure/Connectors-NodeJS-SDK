{
    "name": "@azure/connectors",
    "version": "0.3.1-preview",
    "description": "Azure Connectors SDK for Node.js",
    "type": "module",
    "main": "dist/cjs/azureConnectors/index.js",
    "module": "dist/esm/azureConnectors/index.js",
    "types": "dist/esm/azureConnectors/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/azureConnectors/index.d.ts",
                "default": "./dist/esm/azureConnectors/index.js"
            },
            "require": {
                "types": "./dist/cjs/azureConnectors/index.d.ts",
                "default": "./dist/cjs/azureConnectors/index.js"
            }
        },
        "./generated/*": {
            "import": {
                "types": "./dist/esm/generated/*.d.ts",
                "default": "./dist/esm/generated/*.js"
            },
            "require": {
                "types": "./dist/cjs/generated/*.d.ts",
                "default": "./dist/cjs/generated/*.js"
            }
        }
    },
    "scripts": {
        "prebuild": "node scripts/generate-sdk-info.mjs",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
        "prepack": "npm run build",
        "smoke": "node --input-type=module -e \"import { ConnectorClientBase } from './dist/esm/azureConnectors/index.js'; console.log('ESM OK:', ConnectorClientBase.name)\" && node -e \"const sdk = require('./dist/cjs/azureConnectors/index.js'); console.log('CJS OK:', Object.keys(sdk).length, 'exports')\"",
        "pretest": "npm run build",
        "test": "jest --config config/jest.config.cjs --verbose",
        "typecheck": "tsc --noEmit",
        "typecheck:samples": "tsc -p samples/tsconfig.json --noEmit",
        "lint": "eslint --config config/eslint.config.cjs src/",
        "docs:build": "typedoc && node scripts/validate-api-docs.mjs",
        "docs:test": "node --test scripts/validate-api-docs.test.mjs",
        "lint:md": "markdownlint-cli2 **/*.md #node_modules #dist #site #samples/node_modules"
    },
    "keywords": [
        "azure",
        "cloud",
        "logic-apps",
        "connector-namespaces",
        "connectors",
        "sdk",
        "typescript",
        "javascript"
    ],
    "author": "Microsoft Corporation",
    "license": "MIT",
    "homepage": "https://github.com/Azure/Connectors-NodeJS-SDK#readme",
    "bugs": {
        "url": "https://github.com/Azure/Connectors-NodeJS-SDK/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Azure/Connectors-NodeJS-SDK.git"
    },
    "dependencies": {
        "@azure/abort-controller": "~2.2.0",
        "@azure/core-paging": "~1.7.0",
        "@azure/core-rest-pipeline": "~1.25.0",
        "@azure/core-tracing": "~1.4.0",
        "@azure/identity": "^4.14.0",
        "@azure/logger": "^1.4.0",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@azure/core-auth": "~1.10.1"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "jest": "^30.3.0",
        "markdownlint-cli2": "^0.24.0",
        "ts-jest": "^29.4.15",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ]
}
