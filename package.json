{
    "name": "@azure/azure-connectors",
    "version": "0.1.0",
    "description": "Azure Logic Apps Connector SDK for TypeScript / Node.js",
    "type": "module",
    "main": "dist/azureConnectors/index.js",
    "types": "dist/azureConnectors/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/azureConnectors/index.d.ts",
            "default": "./dist/azureConnectors/index.js"
        },
        "./generated/*": {
            "types": "./dist/generated/*.d.ts",
            "default": "./dist/generated/*.js"
        }
    },
    "scripts": {
        "build": "tsc && tsc -p samples/tsconfig.json --noEmit",
        "test": "jest --config config/jest.config.cjs --verbose",
        "typecheck": "tsc --noEmit && tsc -p samples/tsconfig.json --noEmit",
        "typecheck:samples": "tsc -p samples/tsconfig.json --noEmit",
        "lint": "eslint --config config/eslint.config.cjs src/",
        "lint:md": "markdownlint-cli2 **/*.md #node_modules #dist #samples/node_modules"
    },
    "keywords": [
        "azure",
        "logic-apps",
        "connectors",
        "sdk",
        "typescript",
        "javascript"
    ],
    "author": "Microsoft Corporation",
    "license": "MIT",
    "dependencies": {
        "@azure/identity": "^4.0.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^20.0.0",
        "eslint": "^10.2.1",
        "jest": "^30.3.0",
        "markdownlint-cli2": "^0.22.1",
        "ts-jest": "^29.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ]
}
