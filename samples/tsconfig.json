{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "lib": ["ES2023"],
        "types": ["node"],
        "paths": {
            "@azure/connectors": ["../dist/esm/azureConnectors"],
            "@azure/connectors/*": ["../dist/esm/*"]
        }
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": ["node_modules"]
}
