+            HashSet<string> target,
+            HashSet<string> visitedDefinitions = null)
+        {
+            visitedDefinitions ??= new HashSet<string>(StringComparer.Ordinal);
+
+            if (schema.TryGetPropertyValue(SchemaPropertyNames.Ref, out var referenceNode) &&
+                referenceNode is JsonValue reference &&
+                reference.TryGetValue<string>(out var referenceValue) &&
+                referenceValue.StartsWith(SchemaPropertyNames.DefinitionsRefPrefix, StringComparison.Ordinal) &&
+                document?.TryGetPropertyValue(SchemaPropertyNames.Definitions, out var definitionsNode) == true &&
+                definitionsNode is JsonObject definitions)
+            {
+                var definitionName = referenceValue.Substring(SchemaPropertyNames.DefinitionsRefPrefix.Length);
+                if (visitedDefinitions.Add(definitionName) &&
+                    definitions.TryGetPropertyValue(definitionName, out var definitionSchemaNode) &&
+                    definitionSchemaNode is JsonObject definitionSchema)
+                {
+                    SwaggerRefResolver.CollectRequiredProperties(
+                        definitionSchema,
+                        document,
+                        target,
+                        visitedDefinitions);
+                }
+
+                return;
+            }
+
+            if (schema.TryGetPropertyValue(SchemaPropertyNames.AllOf, out var allOfNode) &&
+                allOfNode is JsonArray allOf)
+            {
+                foreach (var memberNode in allOf)
+                {
+                    if (memberNode is JsonObject member)
+                    {
+                        SwaggerRefResolver.CollectRequiredProperties(
+                            member,
+                            document,
+                            target,
+                            visitedDefinitions);
+                    }
+                }
+            }
+
+            if (schema.TryGetPropertyValue(SchemaPropertyNames.Required, out var requiredNode) &&
+                requiredNode is JsonArray required)
+            {
+                foreach (var propertyNode in required)
+                {
+                    if (propertyNode is JsonValue propertyValue &&
+                        propertyValue.TryGetValue<string>(out var propertyName))
+                    {
+                        target.Add(propertyName);
+                    }
+                }
+            }
+        }
     }
 }
