+        public void Generate_ReferencedFormDataParameter_IsIncludedOnlyForTypeScript()
+        {
+            var swagger = JsonObject.Parse("""
+            {
+                "swagger": "2.0",
+                "info": { "title": "MultipartConnector", "version": "1.0" },
+                "host": "management.azure.com",
+                "basePath": "/",
+                "schemes": ["https"],
+                "paths": {
+                    "/upload": {
+                        "post": {
+                            "operationId": "UploadFile",
+                            "consumes": ["multipart/form-data"],
+                            "parameters": [
+                                { "$ref": "#/parameters/UploadFile" }
+                            ],
+                            "responses": { "204": { "description": "Uploaded" } }
+                        }
+                    }
+                },
+                "parameters": {
+                    "UploadFile": {
+                        "name": "file",
+                        "in": "formData",
+                        "required": true,
+                        "type": "file"
+                    }
+                },
+                "definitions": {}
+            }
+            """).AsObject();
+            using var csharpWriter = new StringWriter();
+            using var pythonWriter = new StringWriter();
+            using var typeScriptWriter = new StringWriter();
+
+            new DirectClientGenerator().Generate(swagger, "multipartconnector", csharpWriter);
+            new DirectClientPythonGenerator().Generate(swagger, "multipartconnector", pythonWriter);
