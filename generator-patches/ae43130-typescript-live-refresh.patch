+        /// <summary>
+        /// Carries typed list items through method signatures, pageable calls, and reference registration.
+        /// </summary>
+        /// <param name="shape">The root, single-page envelope, or continuing envelope shape.</param>
+        /// <param name="itemSchemaText">The inline or referenced item schema.</param>
