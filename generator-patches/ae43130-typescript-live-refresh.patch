+            StringAssert.Contains(value: output, substring: "nullableMap: Record<string, string | number | boolean | null>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "nullableAnyOf?: Record<string, string | null>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "nullableOneOf?: Record<string, boolean | null>;", comparisonType: StringComparison.Ordinal);
