+                    }
+                }
+
+                var scalarTypes = TypeScriptScalarUnionResolver.GetScalarTypes(schema, document, new HashSet<string>(StringComparer.Ordinal));
+                schema[TypeScriptScalarUnionResolver.UnionTypeAnnotation] = string.Join(" | ", scalarTypes.Distinct(StringComparer.Ordinal));
+
+                // NOTE(swapnilnagar): The shared parser requires a string type. An object placeholder retains
+                // response aliases instead of prematurely collapsing their union to a primitive return type.
+                schema["type"] = "object";
+                schema.Remove("anyOf");
+                schema.Remove("oneOf");
+            }
+
+            foreach (var keyword in new[] { "schema", "items", "additionalProperties", "not" })
+            {
+                TypeScriptScalarUnionResolver.VisitSchema(schema[keyword] as JsonObject, document);
+            }
+
+            foreach (var keyword in new[] { "properties", "patternProperties", "$defs", "definitions" })
+            {
+                if (schema[keyword] is JsonObject children)
+                {
+                    foreach (var child in children)
+                    {
+                        TypeScriptScalarUnionResolver.VisitSchema(child.Value as JsonObject, document);
+                    }
+                }
+            }
+
+            if (schema["allOf"] is JsonArray branches)
+            {
+                foreach (var branch in branches)
+                {
+                    TypeScriptScalarUnionResolver.VisitSchema(branch as JsonObject, document);
+                    if (branch is JsonObject branchSchema)
+                    {
+                        var resolvedBranch = SwaggerRefResolver.ResolveSchema(branchSchema, document);
+                        if (resolvedBranch.ContainsKey(TypeScriptScalarUnionResolver.UnionTypeAnnotation) ||
+                            resolvedBranch[SchemaPropertyNames.Type] is JsonArray ||
+                            resolvedBranch.ContainsKey("anyOf") || resolvedBranch.ContainsKey("oneOf"))
+                        {
+                            throw TypeScriptScalarUnionResolver.Unsupported(schema, "allOf intersections with scalar unions");
+                        }
+                    }
+                }
+            }
+        }
+
+        /// <summary>
+        /// Resolves only unconstrained scalar alternatives, rejecting non-disjoint oneOf branches.
+        /// </summary>
+        /// <param name="schema">The union or scalar branch.</param>
+        /// <param name="document">The Swagger document used for scalar references.</param>
+        /// <param name="references">The reference stack used to detect cycles.</param>
+        private static List<string> GetScalarTypes(JsonObject schema, JsonObject document, HashSet<string> references)
+        {
+            if (schema.ContainsKey(TypeScriptScalarUnionResolver.UnionTypeAnnotation))
+            {
+                return ((string)schema[TypeScriptScalarUnionResolver.UnionTypeAnnotation]).Split(" | ", StringSplitOptions.None).ToList();
+            }
+
+            foreach (var keyword in schema.Select(property => property.Key))
+            {
+                if (keyword is not ("type" or "anyOf" or "oneOf" or "$ref") &&
+                    !TypeScriptScalarUnionResolver.AnnotationNames.Contains(keyword))
+                {
+                    throw TypeScriptScalarUnionResolver.Unsupported(schema, $"constraint or dialect keyword '{keyword}'");
+                }
+            }
+
+            if (schema["$ref"] is JsonValue referenceNode && referenceNode.TryGetValue<string>(out var reference))
+            {
+                if (schema.Any(property => property.Key is "type" or "anyOf" or "oneOf") ||
+                    !reference.StartsWith(SchemaPropertyNames.DefinitionsRefPrefix, StringComparison.Ordinal) ||
+                    !references.Add(reference) ||
+                    document["definitions"]?[reference.Substring(SchemaPropertyNames.DefinitionsRefPrefix.Length)] is not JsonObject target)
+                {
+                    throw TypeScriptScalarUnionResolver.Unsupported(schema, $"unresolved, cyclic, external, or constrained reference '{reference}'");
+                }
+
+                var result = TypeScriptScalarUnionResolver.GetScalarTypes(target, document, references);
+                references.Remove(reference);
+                return result;
+            }
+
+            var composition = schema.ContainsKey("oneOf") ? "oneOf" : "anyOf";
+            if (schema.ContainsKey(composition))
+            {
+                if (schema.ContainsKey("type") || schema.ContainsKey("oneOf") && schema.ContainsKey("anyOf") ||
+                    schema[composition] is not JsonArray branches || branches.Count == 0)
+                {
+                    throw TypeScriptScalarUnionResolver.Unsupported(schema, "combined or empty union declarations");
+                }
+
+                var types = new List<string>();
+                foreach (var branch in branches)
+                {
+                    if (branch is not JsonObject branchSchema)
+                    {
+                        throw TypeScriptScalarUnionResolver.Unsupported(schema, "non-object union branch");
+                    }
+
+                    var branchTypes = TypeScriptScalarUnionResolver.GetScalarTypes(branchSchema, document, references);
+                    if (string.Equals(composition, "oneOf", StringComparison.Ordinal) && types.Intersect(branchTypes, StringComparer.Ordinal).Any())
+                    {
+                        throw TypeScriptScalarUnionResolver.Unsupported(schema, "overlapping oneOf branches (including number/integer)");
+                    }
+
+                    types.AddRange(branchTypes);
+                }
+
+                return types;
+            }
+
+            var typeNodes = schema["type"] is JsonArray typeArray
+                ? typeArray.ToArray()
+                : new[] { schema["type"] };
+            if (typeNodes.Length == 0)
+            {
+                throw TypeScriptScalarUnionResolver.Unsupported(schema, "empty type array");
+            }
+
+            return typeNodes.Select(typeNode => typeNode is JsonValue value && value.TryGetValue<string>(out var typeName)
+                ? typeName switch
+                {
+                    "string" => "string",
+                    "integer" or "number" => "number",
+                    "boolean" => "boolean",
+                    "null" => "null",
+                    _ => throw TypeScriptScalarUnionResolver.Unsupported(schema, $"non-scalar type '{typeName}'"),
+                }
+                : throw TypeScriptScalarUnionResolver.Unsupported(schema, "missing or non-string scalar type")).ToList();
+        }
+
+        /// <summary>
+        /// Creates an actionable failure before operation parsing can silently omit an unsupported operation.
+        /// </summary>
+        /// <param name="schema">The unsupported schema.</param>
+        /// <param name="reason">The unsupported union feature.</param>
+        private static NotSupportedException Unsupported(JsonObject schema, string reason)
+        {
+            return new NotSupportedException(
+                message: $"TypeScript scalar union at '{schema.GetPath()}' cannot represent {reason}. Use explicit unconstrained string, number, integer, boolean, or null alternatives; use disjoint oneOf branches or anyOf for overlapping scalars.");
+        }
+    }
