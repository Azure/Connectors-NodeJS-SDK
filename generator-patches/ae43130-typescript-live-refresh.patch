+        /// <summary>
+        /// Rejects unsupported constraints, unresolved references, and unsafe unions before partial output is written.
+        /// </summary>
+        /// <param name="schemaText">The unsupported schema.</param>
+        /// <param name="diagnostic">The expected actionable diagnostic detail.</param>
+        [TestMethod]
+        [DataRow("{\"type\":[\"string\",\"object\"]}", "non-scalar type 'object'")]
+        [DataRow("{\"type\":[\"string\",\"array\"]}", "non-scalar type 'array'")]
+        [DataRow("{\"type\":[]}", "empty type array")]
+        [DataRow("{\"type\":[\"string\",42]}", "non-string scalar type")]
+        [DataRow("{\"type\":[\"string\",\"number\"],\"enum\":[\"a\"]}", "keyword 'enum'")]
+        [DataRow("{\"type\":[\"string\",\"number\"],\"nullable\":true}", "keyword 'nullable'")]
+        [DataRow("{\"type\":[\"string\",\"number\"],\"$schema\":\"https://json-schema.org/draft/2020-12/schema\"}", "dialect")]
+        [DataRow("{\"anyOf\":[{}, {\"type\":\"string\"}]}", "missing or non-string")]
+        [DataRow("{\"oneOf\":[{\"type\":\"number\"},{\"type\":\"integer\"}]}", "overlapping oneOf")]
+        [DataRow("{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"string\"}]}", "overlapping oneOf")]
+        [DataRow("{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"a\"},{\"type\":\"boolean\"}]}", "keyword 'pattern'")]
+        [DataRow("{\"anyOf\":[{\"type\":\"number\",\"minimum\":0},{\"type\":\"boolean\"}]}", "keyword 'minimum'")]
+        [DataRow("{\"anyOf\":[{\"type\":\"string\",\"format\":\"binary\"},{\"type\":\"boolean\"}]}", "keyword 'format'")]
+        [DataRow("{\"anyOf\":[]}", "empty union")]
+        [DataRow("{\"anyOf\":[true]}", "non-object union branch")]
+        [DataRow("{\"anyOf\":[{\"$ref\":\"#/definitions/Missing\"},{\"type\":\"boolean\"}]}", "Missing")]
+        [DataRow("{\"anyOf\":[{\"$ref\":\"other.json#/Thing\"},{\"type\":\"boolean\"}]}", "external")]
+        [DataRow("{\"anyOf\":[{\"$ref\":\"#/definitions/CyclicValue\"},{\"type\":\"boolean\"}]}", "cyclic")]
+        [DataRow("{\"anyOf\":[{\"$ref\":\"#/definitions/StructuredValue\"},{\"type\":\"boolean\"}]}", "keyword 'required'")]
+        [DataRow("{\"allOf\":[{\"type\":[\"string\",\"boolean\"]}]}", "allOf")]
+        [DataRow("{\"not\":{\"type\":[\"string\",\"boolean\"]}}", "unsupported not")]
+        [DataRow("{\"x-codeful-typescript-scalar-union\":\"unknown\"}", "reserved internal union annotation")]
+        [Owner("swapnilnagar")]
+        public void Generate_UnsupportedUnion_FailsBeforeWritingClient(string schemaText, string diagnostic)
+        {
+            var document = JsonNode.Parse(DirectClientTypeScriptScalarUnionTests.ScalarUnionSwagger).AsObject();
+            document["definitions"]["CyclicValue"] = JsonNode.Parse("""{"$ref":"#/definitions/CyclicValue"}""");
+            document["definitions"]["Envelope"]["properties"]["scalar-map"]["additionalProperties"] = JsonNode.Parse(schemaText);
+            using var writer = new StringWriter();
+            var exception = Assert.ThrowsExactly<NotSupportedException>(() => new DirectClientTypeScriptGenerator().Generate(document, "scalarunionfixture", writer));
+            StringAssert.Contains(value: exception.Message, substring: "TypeScript scalar union at '$.definitions.", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: exception.Message, substring: diagnostic, comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: exception.Message, substring: "Use explicit unconstrained", comparisonType: StringComparison.Ordinal);
+            Assert.AreEqual(expected: string.Empty, actual: writer.ToString());
+        }
+
+        /// <summary>
+        /// Keeps declared properties when a typed map also inherits its object shape.
+        /// </summary>
+        /// <param name="inherited">Whether the required property comes from an allOf reference.</param>
+        [TestMethod]
+        [DataRow(false)]
+        [DataRow(true)]
+        [Owner("swapnilnagar")]
+        public void Generate_TypedMapWithDeclaredProperties_PreservesRequiredShape(bool inherited)
+        {
+            var document = JsonNode.Parse(DirectClientTypeScriptScalarUnionTests.ScalarUnionSwagger).AsObject();
+            var schema = JsonNode.Parse("""{"type":"object","additionalProperties":{"type":["string","boolean"]}}""").AsObject();
+            if (inherited)
+            {
+                schema["allOf"] = JsonNode.Parse("""[{"$ref":"#/definitions/StructuredValue"}]""");
+            }
+            else
+            {
+                schema["required"] = JsonNode.Parse("""["wire-name"]""");
+                schema["properties"] = JsonNode.Parse("""{"wire-name":{"type":"string"}}""");
+            }
+
+            document["definitions"]["MixedMap"] = schema;
+            document["definitions"]["MixedMapAlias"] = JsonNode.Parse("""{"$ref":"#/definitions/MixedMap"}""");
+            document["paths"]["/maps"]["get"]["responses"]["200"]["schema"] = JsonNode.Parse("""{"$ref":"#/definitions/MixedMapAlias"}""");
+            var output = DirectClientTypeScriptScalarUnionTests.Generate(document);
+            foreach (var typeName in new[] { "MixedMap", "MixedMapAlias" })
+            {
+                StringAssert.Contains(value: output, substring: $"export interface {typeName} {{\n    \"wire-name\": string;\n}}".Replace("\n", Environment.NewLine, StringComparison.Ordinal), comparisonType: StringComparison.Ordinal);
+                Assert.IsFalse(condition: output.Contains($"export type {typeName} = Record<", StringComparison.Ordinal));
+            }
+        }
+
+        /// <summary>
+        /// Selects the first successful response with a schema, including reusable responses.
+        /// </summary>
+        /// <param name="emptyFirst">Whether the schema-less success precedes the array response.</param>
+        /// <param name="reusable">Whether the schema comes from a reusable response reference.</param>
+        [TestMethod]
+        [DataRow(true, false)]
+        [DataRow(false, false)]
+        [DataRow(true, true)]
+        [DataRow(false, true)]
+        [Owner("swapnilnagar")]
+        public void Generate_SuccessResponseOrdering_PreservesUnionArray(bool emptyFirst, bool reusable)
+        {
+            var document = JsonNode.Parse(DirectClientTypeScriptScalarUnionTests.ScalarUnionSwagger).AsObject();
+            var response = JsonNode.Parse("""{"description":"OK","schema":{"type":"array","items":{"type":["string","boolean"]}}}""");
+            if (reusable)
+            {
+                document["responses"] = new JsonObject { ["UnionArray"] = response };
+                response = JsonNode.Parse("""{"$ref":"#/responses/UnionArray"}""");
+            }
+
+            var responses = new JsonObject();
+            if (emptyFirst)
+            {
+                responses["204"] = JsonNode.Parse("""{"description":"No content"}""");
+            }
+
+            responses["200"] = response;
+            if (!emptyFirst)
+            {
+                responses["204"] = JsonNode.Parse("""{"description":"No content"}""");
+            }
+
+            document["paths"]["/maps"]["get"]["responses"] = responses;
+            var output = DirectClientTypeScriptScalarUnionTests.Generate(document);
+            StringAssert.Contains(value: output, substring: "export type GetMapsResponse = Array<string | boolean>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "getMaps(options: ConnectorOperationOptions = {}): Promise<GetMapsResponse>", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "this.sendWithTracingAsync<GetMapsResponse>", comparisonType: StringComparison.Ordinal);
+            Assert.IsFalse(condition: output.Contains("Array<Record<string, unknown>>", StringComparison.Ordinal));
+        }
