+        /// <summary>
+        /// Keeps unresolved inline and referenced dynamic bodies open without widening static maps.
+        /// </summary>
+        [TestMethod]
+        [Owner("swapnilnagar")]
+        public void Generate_TypeScriptDynamicSchema_PreservesFlatBodiesAndStaticControls()
+        {
+            var output = DirectClientAdditionalPropertiesMapTests.GenerateTypeScript(
+                JsonObject.Parse(DirectClientAdditionalPropertiesMapTests.DynamicItemSwagger).AsObject());
+
+            foreach (var typeName in new[] { "PostItemInput", "DynamicBody" })
+            {
+                StringAssert.Contains(
+                    value: output,
+                    substring: $"export interface {typeName} {{{Environment.NewLine}    [key: string]: unknown;{Environment.NewLine}}}",
+                    comparisonType: StringComparison.Ordinal);
+            }
+
+            StringAssert.Contains(value: output, substring: "input: PostItemInput", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "input: DynamicBody", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "dynamicMap?: Record<string, unknown>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "structuredMap?: Record<string, StaticValue>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "scalarMap?: Record<string, string | number | boolean>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "dynamicValuesOnly?: Record<string, StaticValue>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "mapOfDynamicBodies?: Record<string, DynamicBody>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "export type StaticMap = Record<string, StaticValue>;", comparisonType: StringComparison.Ordinal);
+            StringAssert.Contains(value: output, substring: "name: string;", comparisonType: StringComparison.Ordinal);
+        }
