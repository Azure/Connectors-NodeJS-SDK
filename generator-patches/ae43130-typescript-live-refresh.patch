+        /// <summary>
+        /// Verifies concrete map values, independent nullability, reference models, and exact wire names.
+        /// </summary>
+        [TestMethod]
+        [Owner("swapnilnagar")]
+        public void Generate_PinnedScalarUnions_PreservesConcreteMapsAndInventory()
+        {
+            var document = JsonNode.Parse(DirectClientTypeScriptScalarUnionTests.ScalarUnionSwagger).AsObject();
+            var output = DirectClientTypeScriptScalarUnionTests.GenerateFixture();
+            foreach (var declaration in new[]
+            {
+                "\"scalar-map\": Record<string, string | number | boolean>;",
+                "scalar_map?: Record<string, string | number | boolean>;",
+                "oneOfMap?: Record<string, string | number | boolean>;",
+                "nullableMap: Record<string, string | number | boolean | null>;",
+                "nullableAnyOf?: Record<string, string | null>;",
+                "nullableOneOf?: Record<string, boolean | null>;",
+                "numericMap?: Record<string, number>;",
+                "implicitMap?: Record<string, string | boolean>;",
+                "arrayMap?: Record<string, Array<string | boolean>>;",
+                "structuredMap?: Record<string, StructuredValue>;",
+                "structuredArray?: Array<StructuredValue>;",
+                "emptyObject?: Record<string, unknown>;",
+                "emptyMap?: Record<string, unknown>;",
+                "\"wire-name\": string;",
+            })
+            {
+                StringAssert.Contains(value: output, substring: declaration, comparisonType: StringComparison.Ordinal);
+            }
+
+            var envelopeBody = Regex.Match(output, @"export interface Envelope \{(?<body>.*?)\r?\n\}", RegexOptions.Singleline).Groups["body"].Value;
+            var emittedProperties = Regex.Matches(envelopeBody, @"^    (?<name>\""[^\""\r\n]+\""|[\w$]+)\??:", RegexOptions.Multiline)
+                .Select(match => match.Groups["name"].Value.Trim('"')).ToArray();
+            CollectionAssert.AreEquivalent(
+                expected: document["definitions"]["Envelope"]["properties"].AsObject().Select(property => property.Key).ToArray(),
+                actual: emittedProperties);
+            var emittedOperations = Regex.Matches(output, @"public async (?<operation>\w+)\(")
+                .Select(match => match.Groups["operation"].Value).ToArray();
+            var expectedOperations = document["paths"]["/maps"].AsObject()
+                .Select(operation => (string)operation.Value["operationId"])
+                .Select(operationId => char.ToLowerInvariant(operationId[0]) + operationId.Substring(1)).ToArray();
+            CollectionAssert.AreEquivalent(expected: expectedOperations, actual: emittedOperations);
+        }
+
+        /// <summary>
+        /// Verifies unions at response, body, named definition, and array item boundaries survive shared parsing.
+        /// </summary>
+        [TestMethod]
+        [Owner("swapnilnagar")]
+        public void Generate_RootAndReferencedUnions_DoesNotWidenOrDropOperations()
+        {
+            foreach (var schemaText in new[]
+            {
+                """{"type":["string","number","null"]}""",
+                """{"anyOf":[{"type":"string"},{"type":"boolean"}]}""",
+                """{"type":"array","items":{"type":["string","boolean"]}}""",
+            })
+            {
+                var document = JsonNode.Parse(DirectClientTypeScriptScalarUnionTests.ScalarUnionSwagger).AsObject();
+                document["paths"]["/maps"]["get"]["responses"]["200"]["schema"] = JsonNode.Parse(schemaText);
+                document["paths"]["/maps"]["post"]["parameters"][0]["schema"] = JsonNode.Parse(schemaText);
+                document["definitions"]["UnionValue"] = JsonNode.Parse(schemaText);
+                document["paths"]["/maps"]["post"]["responses"]["200"]["schema"] = JsonNode.Parse("""{"$ref":"#/definitions/UnionValue"}""");
+                var output = DirectClientTypeScriptScalarUnionTests.Generate(document);
+                var expectedType = schemaText.Contains("array", StringComparison.Ordinal)
+                    ? "Array<string | boolean>"
+                    : schemaText.Contains("number", StringComparison.Ordinal) ? "string | number | null" : "string | boolean";
+                StringAssert.Contains(value: output, substring: $"= {expectedType};", comparisonType: StringComparison.Ordinal);
+                Assert.IsFalse(condition: output.Contains("Array<Record<string, unknown>>", StringComparison.Ordinal));
+                StringAssert.Contains(value: output, substring: $"export type GetMapsResponse = {expectedType};", comparisonType: StringComparison.Ordinal);
+                StringAssert.Contains(value: output, substring: "getMaps(options: ConnectorOperationOptions = {}): Promise<GetMapsResponse>", comparisonType: StringComparison.Ordinal);
+                StringAssert.Contains(value: output, substring: $"export type UpdateMapsInput = {expectedType};", comparisonType: StringComparison.Ordinal);
+                StringAssert.Contains(value: output, substring: "updateMaps(input: UpdateMapsInput,", comparisonType: StringComparison.Ordinal);
+            }
+        }
+
+        /// <summary>
+        /// Verifies explicit null alternatives remain independent of map optionality.
