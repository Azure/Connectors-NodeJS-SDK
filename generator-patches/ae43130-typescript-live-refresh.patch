+                "oneOfMap": { "type": "object", "additionalProperties": { "oneOf": [{ "$ref": "#/definitions/Text" }, { "type": "number" }, { "type": "boolean" }] } },
+                "nullableMap": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
+                "nullableAnyOf": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
+                "nullableOneOf": { "type": "object", "additionalProperties": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] } },
+                "numericMap": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "integer" }, { "type": "number" }] } },
+                "implicitMap": { "additionalProperties": { "type": ["string", "boolean"] } },
+                "arrayMap": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": ["string", "boolean"] } } },
