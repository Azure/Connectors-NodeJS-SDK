+    /// <summary>
+    /// Validates and lowers explicit scalar unions before the shared Swagger parser reads string types.
+    /// </summary>
+    internal static class TypeScriptScalarUnionResolver
+    {
+        /// <summary>
+        /// Carries a validated TypeScript type through schema clones without changing other language targets.
+        /// </summary>
+        internal const string UnionTypeAnnotation = "x-codeful-typescript-scalar-union";
+
+        /// <summary>
+        /// Schema annotations that do not constrain the scalar value domain.
+        /// </summary>
+        private static readonly HashSet<string> AnnotationNames = new(StringComparer.Ordinal)
+        {
+            "title", "description", "default", "example", "examples", "readOnly", "writeOnly", "deprecated",
+        };
+
+        /// <summary>
+        /// Gets a lowered union type, including array wrappers, without widening its item type.
+        /// </summary>
+        /// <param name="schema">The lowered schema.</param>
+        internal static string GetInlineUnionType(JsonObject schema)
+        {
+            if (schema?[TypeScriptScalarUnionResolver.UnionTypeAnnotation] is JsonValue unionType)
+            {
+                return unionType.GetValue<string>();
+            }
+
+            if (schema?["type"] is JsonValue type && type.TryGetValue<string>(out var typeName) &&
+                string.Equals(typeName, "array", StringComparison.Ordinal) && schema["items"] is JsonObject items &&
+                TypeScriptScalarUnionResolver.GetInlineUnionType(items) is string itemType)
+            {
+                return $"Array<{itemType}>";
+            }
+
+            return null;
+        }
+
+        /// <summary>
+        /// Lowers unions in Swagger schema positions, leaving examples and arbitrary extension payloads untouched.
+        /// </summary>
+        /// <param name="document">The TypeScript generator's Swagger document.</param>
+        internal static void Prepare(JsonObject document)
+        {
+            TypeScriptScalarUnionResolver.ValidateInputAnnotations(document);
+            foreach (var collectionName in new[] { "definitions", "parameters", "responses" })
+            {
+                if (document[collectionName] is JsonObject collection)
+                {
+                    foreach (var entry in collection)
+                    {
+                        TypeScriptScalarUnionResolver.VisitSchema(entry.Value as JsonObject, document);
+                    }
+                }
+            }
+
+            foreach (var collectionName in new[] { "paths", "x-ms-paths" })
+            {
+                if (document[collectionName] is not JsonObject paths)
+                {
+                    continue;
+                }
+
+                foreach (var path in paths)
+                {
+                    if (path.Value is not JsonObject operations)
+                    {
+                        continue;
+                    }
+
+                    TypeScriptScalarUnionResolver.VisitParameters(operations, document);
+                    foreach (var operation in operations)
+                    {
+                        if (operation.Value is not JsonObject operationSchema)
+                        {
+                            continue;
+                        }
+
+                        TypeScriptScalarUnionResolver.VisitParameters(operationSchema, document);
+                        if (operationSchema["responses"] is JsonObject responses)
+                        {
+                            foreach (var response in responses)
+                            {
+                                TypeScriptScalarUnionResolver.VisitSchema(response.Value?["schema"] as JsonObject, document);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        /// <summary>
+        /// Rejects input that claims to contain an already validated internal type.
+        /// </summary>
+        /// <param name="node">The input document or child node.</param>
+        private static void ValidateInputAnnotations(JsonNode node)
