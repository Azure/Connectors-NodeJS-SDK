+        private void GenerateMultipartFormDataTypes(
+            StringBuilder stringBuilder,
+            IReadOnlyList<DirectClientMethodInfo> methods,
+            IReadOnlyDictionary<DirectClientMethodInfo, string> resolvedMethodNames)
+        {
+            foreach (var method in methods.Where(method => method.HasFormDataParameters))
+            {
+                var typeName = DirectClientTypeScriptCodeGenerator.GetMultipartFormDataTypeName(resolvedMethodNames[method]);
+                if (!this._generatedTypes.Add(typeName))
+                {
+                    throw new InvalidOperationException(
+                        message: $"Connector '{this._connectorName}' operation '{method.OperationId}' generates multipart input type '{typeName}', which collides with another public type.");
+                }
+
+                var parameters = method.FormDataParameters.ToList();
+                var propertyNames = this.ResolveMultipartFormDataPropertyNames(method, parameters);
+                stringBuilder.AppendLine();
+                stringBuilder.AppendLine("/**");
+                stringBuilder.AppendLine($" * Multipart form data for the {resolvedMethodNames[method]} operation.");
+                stringBuilder.AppendLine(" */");
+                stringBuilder.AppendLine($"export interface {typeName} {{");
+                foreach (var parameter in parameters)
+                {
+                    var description = parameter.Description ?? $"The '{parameter.Name}' form field.";
+                    var optionalMarker = parameter.IsRequired ? string.Empty : "?";
+                    stringBuilder.AppendLine($"    /** {DirectClientTypeScriptCodeGenerator.EscapeJsDoc(description)} */");
+                    stringBuilder.AppendLine($"    {propertyNames[parameter]}{optionalMarker}: {this.GetTypeScriptTypeForParameter(parameter)};");
+                }
+
+                stringBuilder.AppendLine("}");
+            }
+        }
