+        /// <summary>
+        /// Verifies root schema shapes retain their JSON types in generated TypeScript declarations.
+        /// </summary>
+        [TestMethod]
+        [Owner("swapnilnagar")]
+        public void Generate_RootArrayIntegerEnumAndAllOf_PreserveSchemaShapes()
+        {
+            var swagger = JsonObject.Parse(FormatTestSwagger).AsObject();
+            var definitions = swagger[SchemaPropertyNames.Definitions].AsObject();
+            definitions["ItemModelArray"] = new JsonObject
+            {
+                [SchemaPropertyNames.Type] = SchemaTypeNames.Array,
+                [SchemaPropertyNames.Items] = new JsonObject
+                {
+                    [SchemaPropertyNames.Ref] = "#/definitions/ItemModel",
+                },
+            };
+            definitions["NumericState"] = new JsonObject
+            {
+                [SchemaPropertyNames.Type] = SchemaTypeNames.Integer,
+                [SchemaPropertyNames.Enum] = new JsonArray(0, 1, 2),
+            };
+            definitions["BaseRecord"] = new JsonObject
+            {
+                [SchemaPropertyNames.Type] = SchemaTypeNames.Object,
+                [SchemaPropertyNames.Properties] = new JsonObject
+                {
+                    ["baseValue"] = new JsonObject
+                    {
+                        [SchemaPropertyNames.Type] = SchemaTypeNames.String,
+                    },
+                },
+            };
+            definitions["ComposedRecord"] = new JsonObject
+            {
+                [SchemaPropertyNames.AllOf] = new JsonArray
+                {
+                    new JsonObject
+                    {
+                        [SchemaPropertyNames.Ref] = "#/definitions/BaseRecord",
+                    },
+                    new JsonObject
+                    {
+                        [SchemaPropertyNames.Type] = SchemaTypeNames.Object,
+                        [SchemaPropertyNames.Properties] = new JsonObject
+                        {
+                            ["inlineValue"] = new JsonObject
+                            {
+                                [SchemaPropertyNames.Type] = SchemaTypeNames.Integer,
+                            },
+                        },
+                    },
+                },
+            };
+            var generator = new DirectClientTypeScriptGenerator();
+            using var writer = new StringWriter();
+
+            generator.Generate(swagger, "formattest", writer);
+
+            var output = writer.ToString();
+            Assert.IsTrue(
+                condition: output.Contains("export type ItemModelArray = Array<ItemModel>;", StringComparison.Ordinal) &&
+                    output.Contains("export type NumericState = 0 | 1 | 2;", StringComparison.Ordinal) &&
+                    output.Contains("export interface ComposedRecord {", StringComparison.Ordinal) &&
+                    output.Contains("baseValue?: string;", StringComparison.Ordinal) &&
+                    output.Contains("inlineValue?: number;", StringComparison.Ordinal),
+                message: "Array, numeric enum, and allOf roots should preserve their wire shapes.");
+            Assert.IsFalse(
+                condition: output.Contains("export interface ItemModelArray", StringComparison.Ordinal) ||
+                    output.Contains("export type NumericState = \"0\" | \"1\" | \"2\";", StringComparison.Ordinal),
+                message: "Root arrays must not become objects and numeric enums must not become strings.");
+        }
