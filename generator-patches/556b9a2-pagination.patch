+        private bool DetectPagination(JsonObject schema, SwaggerContext context, out string itemTypeName)
+        {
+            itemTypeName = null;
+
+            var properties = new JsonObject();
+            SwaggerRefResolver.CollectProperties(schema, context.Document, properties);
+
+            var nextLinkPropertyNames = new[]
+            {
+                SchemaPropertyNames.PaginationNextLink,
+                SchemaPropertyNames.ODataNextLink,
+            };
+            var hasStringNextLink = nextLinkPropertyNames.Any(propertyName =>
+            {
+                if (!properties.TryGetPropertyValue(propertyName, out var nextLinkNode) ||
+                    nextLinkNode is not JsonObject nextLinkSchema)
+                {
+                    return false;
+                }
+
+                var resolvedNextLinkSchema = SwaggerRefResolver.ResolveSchema(nextLinkSchema, context.Document);
+                return resolvedNextLinkSchema.TryGetPropertyValue(SchemaPropertyNames.Type, out var nextLinkTypeNode) &&
+                    nextLinkTypeNode is JsonValue nextLinkType &&
+                    nextLinkType.TryGetValue<string>(out var nextLinkTypeName) &&
+                    string.Equals(nextLinkTypeName, "string", StringComparison.Ordinal);
+            });
+
+            if (!hasStringNextLink ||
+                !properties.TryGetPropertyValue(SchemaPropertyNames.PaginationValue, out var valueNode) ||
+                valueNode is not JsonObject rawValueSchema)
