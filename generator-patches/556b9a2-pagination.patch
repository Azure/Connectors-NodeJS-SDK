+                return false;
+            }
+
+            var valueSchema = SwaggerRefResolver.ResolveSchema(rawValueSchema, context.Document);
+            if (!string.Equals((string)valueSchema[SchemaPropertyNames.Type], "array", StringComparison.Ordinal) ||
+                !valueSchema.TryGetPropertyValue(SchemaPropertyNames.Items, out var itemsNode) ||
+                itemsNode is not JsonObject items)
+            {
+                return false;
+            }
+
+            if (items.TryGetPropertyValue(SchemaPropertyNames.Ref, out var itemReferenceNode))
+            {
+                var itemReference = (string)itemReferenceNode;
+                if (itemReference.StartsWith(SchemaPropertyNames.DefinitionsRefPrefix, StringComparison.Ordinal))
+                {
+                    itemTypeName = itemReference.Substring(SchemaPropertyNames.DefinitionsRefPrefix.Length);
+                    return true;
+                }
+            }
+
+            itemTypeName = (string)items[SchemaPropertyNames.Type] switch
+            {
+                "string" => this.TypeMap.StringType,
+                "integer" => this.TypeMap.IntegerType,
+                "number" => this.TypeMap.NumberType,
+                "boolean" => this.TypeMap.BooleanType,
+                _ => this.TypeMap.UnknownType,
+            };
+            return true;
