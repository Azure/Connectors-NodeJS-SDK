+        /// <summary>
+        /// Verifies annotation-only pagination remains a TypeScript projection and does not create an
+        /// incomplete C# <c>IPageable&lt;T&gt;</c> model.
+        /// </summary>
+        [TestMethod]
+        [Owner("swapnilnagar")]
+        public void Generate_AnnotationOnlyPagination_CSharpModelCompilesWithoutPageableContract()
+        {
+            var swagger = JsonObject.Parse(SwaggerWithAnnotationOnlyPagination).AsObject();
+            var generator = new DirectClientGenerator();
+            using var writer = new StringWriter();
+
+            generator.Generate(swagger, "annotationpaginationconnector", writer);
+
+            var output = writer.ToString();
+            Assert.IsFalse(
+                condition: output.Contains("class ItemsList : IPageable<Item>", StringComparison.Ordinal),
+                message: "C# must not project annotation-only pagination without concrete interface members.");
+            Assert.IsFalse(
+                condition: output.Contains("AsyncPageable<Item> GetItemsAsync", StringComparison.Ordinal),
+                message: "C# must retain a normal response method for annotation-only pagination.");
+
+            var generatedSyntax = CSharpSyntaxTree.ParseText(output).GetCompilationUnitRoot();
+            var modelsNamespace = generatedSyntax.Members
+                .OfType<Microsoft.CodeAnalysis.CSharp.Syntax.NamespaceDeclarationSyntax>()
+                .First();
+            var compilationSource = $$"""
+                #nullable disable
+                using System;
+                using System.Collections.Generic;
+                using System.Text.Json;
+                using System.Text.Json.Serialization;
+                using Azure.Connectors.Sdk;
+
+                namespace Azure.Connectors.Sdk
+                {
+                    public interface IPageable<T>
+                    {
+                        List<T> Value { get; set; }
+
+                        string NextLink { get; set; }
+                    }
+                }
+
+                {{modelsNamespace}}
+                """;
+            var referencePaths = ((string)AppContext.GetData("TRUSTED_PLATFORM_ASSEMBLIES"))
+                .Split(Path.PathSeparator);
+            var compilation = CSharpCompilation.Create(
+                assemblyName: "GeneratedAnnotationOnlyPaginationModels",
+                syntaxTrees: new[] { CSharpSyntaxTree.ParseText(compilationSource) },
+                references: RoslynCompilationTestHelper.CreateMetadataReferencesForExistingAssemblies(referencePaths),
+                options: new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));
+            var compilationErrors = compilation
+                .GetDiagnostics()
+                .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error)
+                .ToArray();
+
+            Assert.AreEqual(
+                expected: 0,
+                actual: compilationErrors.Length,
+                message: $"Annotation-only C# models must compile. Errors: {string.Join(Environment.NewLine, compilationErrors.Select(diagnostic => diagnostic.ToString()))}");
+        }
+
