+        /// <param name="enumValue">The Swagger enum value.</param>
+        /// <param name="schemaType">The declared Swagger schema type.</param>
+        private static string GetTypeScriptLiteralValue(JsonNode enumValue, string schemaType)
+        {
+            if (enumValue is JsonValue jsonValue &&
+                jsonValue.TryGetValue<string>(out var stringValue) &&
+                string.Equals(schemaType, SchemaTypeNames.Integer, StringComparison.Ordinal) &&
+                long.TryParse(stringValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var integerValue))
+            {
+                return integerValue.ToString(CultureInfo.InvariantCulture);
+            }
+
+            return enumValue?.ToJsonString() ?? "null";
+        }
+
