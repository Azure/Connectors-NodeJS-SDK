+                    string.Equals(word.Value, preferredVerb, StringComparison.Ordinal));
+            }
+
+            if (actionWord == null &&
+                (words.Count == 0 || !DirectClientTypeScriptCodeGenerator.TypeScriptActionVerbs.Contains(words[0].Value)))
