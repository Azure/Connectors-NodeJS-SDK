+//------------------------------------------------------------
+
+namespace Microsoft.Azure.Workflows.CodefulSdkGenerator.DirectClient
+{
+    using System;
+    using System.Collections.Generic;
+
+    /// <summary>
+    /// Provides stable TypeScript method names for operation identities whose default projections collide.
+    /// </summary>
+    internal static class DirectClientTypeScriptMethodNameOverrides
+    {
+        /// <summary>
+        /// Stable method names keyed by connector and swagger operation identifier.
+        /// </summary>
+        private static readonly IReadOnlyDictionary<string, IReadOnlyDictionary<string, string>> NamesByConnector =
+            new Dictionary<string, IReadOnlyDictionary<string, string>>(StringComparer.OrdinalIgnoreCase)
+            {
+                ["sharepointonline"] = new Dictionary<string, string>(StringComparer.Ordinal)
+                {
+                    ["CopyFile"] = "copyFileLegacy",
+                    ["CopyFileAsync"] = "copyFile",
+                },
+            };
+
+        /// <summary>
+        /// Gets a curated method name for an operation, or the default projected name when no override exists.
+        /// </summary>
+        /// <param name="connectorName">The connector API name.</param>
+        /// <param name="operationId">The swagger operation identifier.</param>
+        /// <param name="defaultName">The default projected TypeScript method name.</param>
+        public static string GetName(string connectorName, string operationId, string defaultName)
+        {
+            return DirectClientTypeScriptMethodNameOverrides.NamesByConnector.TryGetValue(connectorName, out var namesByOperation) &&
+                namesByOperation.TryGetValue(operationId, out var methodName)
+                    ? methodName
+                    : defaultName;
+        }
+    }
+}
